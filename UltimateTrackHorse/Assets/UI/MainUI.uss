:root {
    --color-bg-overlay: rgba(30, 40, 30, 0.85);
    --color-panel: #F5F5DC; /* Beige */
    --color-primary: #7FBF7F; /* Soft Green */
    --color-primary-dark: #5D8F5D;
    --color-accent: #8B4513; /* Brown */
    --color-text: #333333;
    --color-text-light: #F5F5DC;
}

.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

/* This new class hides the root container's background when entering the actual game! */
.root-container.game-active-bg {
    background-image: none !important;
    background-color: transparent !important;
}

.view-container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-overlay);
    transition-duration: 0.3s;
    transition-property: opacity, display;
}

/* New layout class to cleanly push the Main Menu to the left side */
.left-aligned {
    align-items: flex-start;
    padding-left: 10%;
}

.hidden {
    opacity: 0;
    display: none;
}

.panel {
    background-color: var(--color-panel);
    border-radius: 24px;
    padding: 50px 60px; /* Slightly larger padding to breathe */
    align-items: center;
    border-width: 4px;
    border-color: var(--color-accent);
}

.title-label {
    font-size: 58px; /* Slightly bigger */
    -unity-font-style: bold;
    color: var(--color-accent);
    margin-bottom: 35px;
    text-shadow: 2px 5px 0 rgba(0, 0, 0, 0.4); /* Nice 3D text shadow */
}

/* Styles for the new About Us popup text */
.about-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-top: 15px;
    text-shadow: 1px 2px 0 rgba(0, 0, 0, 0.5);
}

.animated-button {
    width: 280px; /* Make buttons slightly bigger */
    height: 70px;
    margin-bottom: 18px;
    font-size: 28px;
    -unity-font-style: bold;
    border-radius: 12px;
    
    /* 3D button border trick */
    border-top-width: 0px;
    border-left-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 6px; 
    border-color: rgba(0, 0, 0, 0.35); /* Shaded bottom ridge */
    
    background-color: var(--color-primary);
    color: var(--color-text-light);
    
    text-shadow: 1px 2px 0 rgba(0, 0, 0, 0.4); /* 3D text depth */
    
    /* Snappy 0.1s transition so the press registers instantly */
    transition-duration: 0.1s;
    transition-property: scale, background-color, border-bottom-width, translate;
}

.animated-button:hover {
    scale: 1.05;
    background-color: var(--color-primary-dark);
}

.animated-button:active {
    scale: 0.98;
    background-color: var(--color-accent);
    
    /* Physical 3D push-down effect when clicked! */
    border-bottom-width: 0px; 
    translate: 0 6px; 
}

.horizontal-scroll {
    flex-direction: row;
    padding: 20px;
}

.card {
    width: 150px;
    height: 200px;
    background-color: var(--color-primary-dark);
    margin: 10px;
    border-radius: 16px;
    align-items: center;
    justify-content: center;
}

.card-label {
    color: var(--color-text-light);
    -unity-font-style: bold;
    margin-top: 10px;
}

.input-field {
    width: 260px;
    height: 50px;
    font-size: 20px;
    margin-bottom: 20px;
    border-radius: 8px;
}

.top-bar {
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.custom-length-label {
    color: var(--color-accent);
    -unity-font-style: bold;
}

.hud-box {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: var(--color-panel);
    padding: 10px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--color-accent);
}

.hud-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-text);
}

/* LAP HISTORY STYLES */
.lap-history {
    background-color: rgba(42, 49, 60, 0.85); /* Semi-transparent panel color matching var(--color-panel) */
    padding: 15px;
    min-width: 170px;
    border-color: rgba(139, 69, 19, 0.6); /* Subtle border matching accent */
    border-top-width: 2px;
}

.history-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-accent);
    border-bottom-width: 2px;
    border-color: rgba(139, 69, 19, 0.3);
    margin-bottom: 8px;
    padding-bottom: 4px;
    -unity-text-align: middle-center;
}

.history-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-bottom: 3px;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5);
}

/* Highlight style for the fastest run */
.best-time-label {
    color: #32CD32; /* Brighter Lime Green */
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.6);
}

/* Divider beneath the best lap */
.history-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
    margin-top: 4px;
    margin-bottom: 4px;
    width: 100%;
}

.tacho-wrapper {
    position: absolute;
    bottom: 0px; /* Changed from 25px to 0px so it sits perfectly flush with the bottom screen edge! */
    width: 100%;
    align-items: center; /* Horizontally centers the dial cleanly! */
}

.tachometer-container {
    width: 280px; /* Scaled down from 360px */
    height: 140px; /* Exactly half of the width */
    align-items: center;
    justify-content: flex-end;
    overflow: hidden; /* Clips off the excess half of the circle */
}

.tachometer-dial {
    position: absolute;
    top: 0px; 
    width: 280px; /* Scaled down */
    height: 280px; /* Scaled down */
    border-radius: 50%;
    background-color: rgba(26, 32, 40, 0.95); /* Heavy metallic grey background */
    
    border-width: 10px; /* Slightly thinner border to match scale */
    border-color: #58A6FF; /* Glowing blue rim */
    border-right-color: #E2B714; /* Orange/Yellow 'warning' rim on the high-speed side */
    border-bottom-color: transparent; 
}

.tachometer-needle {
    position: absolute;
    bottom: 0px; 
    width: 6px; /* Slightly thinner needle */
    height: 120px; /* Scaled down needle length so it stays inside the rim */
    background-color: #FF4A4A; /* Racing Red sports needle */
    border-radius: 3px;
    transform-origin: bottom center; /* This is what makes it physically rotate around the base! */
}

.tachometer-pivot {
    position: absolute;
    bottom: -24px; /* Mathematically center it on the flat edge (half of 48px) */
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #111; /* Carbon black cap */
    border-width: 4px; /* Scaled down */
    border-color: #E2B714; /* Gold inner ring */
}

.tachometer-text {
    position: absolute;
    bottom: 30px; /* Hover just above the new smaller cap */
    font-size: 26px; /* Scaled down text */
    -unity-font-style: bold;
    color: #FFFFFF;
    text-shadow: 2px 3px 6px rgba(0, 0, 0, 0.85); /* Deep shadow */
}

/* ======================================================== */
/* ?? COUNTDOWN TEXT ANIMATIONS                               */
/* ======================================================== */

.countdown-container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.countdown-text {
    font-size: 200px;
    -unity-font-style: bold;
    color: #E2B714; /* Bold Racing Gold */
    text-shadow: 4px 10px 0 rgba(0, 0, 0, 0.7);
    -unity-text-outline: 3px rgba(255, 255, 255, 0.2); /* Slight white outline for pop */
    transition-duration: 0.15s;
    transition-property: scale;
}

.countdown-pop {
    scale: 1.4; /* Huge pop in size when numbers jump onto the screen! */
}

/* Stats text for Victory/Defeat popups */
.stat-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 5px;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.3);
}

