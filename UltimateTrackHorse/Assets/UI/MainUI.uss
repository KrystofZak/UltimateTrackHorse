:root {
    --color-bg-overlay: rgba(30, 40, 30, 0.85);
    --color-panel: #F5F5DC; /* Beige */
    --color-primary: #7FBF7F; /* Soft Green */
    --color-primary-dark: #5D8F5D;
    --color-accent: #8B4513; /* Brown */
    --color-text: #333333;
    --color-text-light: #F5F5DC;
}

.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.view-container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-overlay);
    transition-duration: 0.3s;
    transition-property: opacity, display;
}

.hidden {
    opacity: 0;
    display: none;
}

.panel {
    background-color: var(--color-panel);
    border-radius: 24px;
    padding: 40px;
    align-items: center;
    border-width: 4px;
    border-color: var(--color-accent);
}

.title-label {
    font-size: 50px;
    -unity-font-style: bold;
    color: var(--color-accent);
    margin-bottom: 30px;
}

.animated-button {
    width: 260px;
    height: 65px;
    margin-bottom: 15px;
    font-size: 24px;
    -unity-font-style: bold;
    border-radius: 12px;
    border-width: 0;
    background-color: var(--color-primary);
    color: var(--color-text-light);
    transition-duration: 0.15s;
    transition-property: scale, background-color;
}

.animated-button:hover {
    scale: 1.05;
    background-color: var(--color-primary-dark);
}

.animated-button:active {
    scale: 0.95;
    background-color: var(--color-accent);
}

.horizontal-scroll {
    flex-direction: row;
    padding: 20px;
}

.card {
    width: 150px;
    height: 200px;
    background-color: var(--color-primary-dark);
    margin: 10px;
    border-radius: 16px;
    align-items: center;
    justify-content: center;
}

.card-label {
    color: var(--color-text-light);
    -unity-font-style: bold;
    margin-top: 10px;
}

.input-field {
    width: 260px;
    height: 50px;
    font-size: 20px;
    margin-bottom: 20px;
    border-radius: 8px;
}

.top-bar {
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.custom-length-label {
    color: var(--color-accent);
    -unity-font-style: bold;
}

.hud-box {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: var(--color-panel);
    padding: 10px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--color-accent);
}

.hud-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-text);
}
