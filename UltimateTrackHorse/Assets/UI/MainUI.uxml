<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainUI.uss?fileID=7433441132597879392&amp;guid=4ffe49d19757b9e409b9535da0ab20d0&amp;type=3#MainUI"/>
    <ui:VisualElement name="RootContainer" enabled="true" class="root-container" style="background-color: transparent;">
        <ui:VisualElement name="mainMenuView" class="view-container left-aligned" style="background-image: none;">
            <ui:VisualElement name="WhiteBoard" class="panel">
                <ui:Label text="Ultimate Track Horse" name="TitleLabel" class="title-label"/>
                <ui:Button text="Play" name="PlayButton" class="animated-button"/>
                <ui:Button text="Settings" name="SettingsButton" class="animated-button"/>
                <ui:Button text="About Us" name="AboutButton" class="animated-button"/>
                <ui:Button text="Discord Connect" name="DiscordConnectButton" class="animated-button" style="background-color: rgb(88,101,242); color: white;"/>
                <ui:Button text="Quit" name="QuitButton" class="animated-button" style="background-color: rgb(139, 69, 19);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="mapSelectionView" class="view-container hidden" style="background-image: none;">
            <ui:VisualElement name="WhiteBoard" class="panel">
                <ui:Label text="Run Type" class="title-label"/>
                <ui:Button text="Random" name="Random" class="animated-button"/>
                <ui:Button text="Seeded" name="Seeded" class="animated-button"/>
                <ui:Button text="Back" name="MapBackButton" class="animated-button" style="margin-top: 20px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="randomSelectionView" class="view-container hidden" style="background-image: none;">
            <ui:VisualElement name="WhiteBoard" class="panel">
                <ui:Label text="Track Length" class="title-label"/>
                <ui:Button text="Short (5)" name="Length5" class="animated-button"/>
                <ui:Button text="Medium (10)" name="Length10" class="animated-button"/>
                <ui:Button text="Long (15)" name="Length15" class="animated-button"/>
                <ui:VisualElement style="margin-top: 10px; align-items: center;">
                    <ui:Label text="Custom Length:" class="custom-length-label"/>
                    <ui:TextField name="LengthCustomInput" value="20" class="input-field"/>
                    <ui:Button text="Play Custom" name="LengthCustomPlay" class="animated-button"/>
                </ui:VisualElement>
                <ui:Button text="Back" name="RandomBackButton" class="animated-button" style="margin-top: 20px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="seededSelectionView" class="view-container hidden" style="background-image: none;">
            <ui:VisualElement name="WhiteBoard" class="panel">
                <ui:Label text="Seeded Run" class="title-label"/>
                <ui:TextField name="SeedInput" value="Enter Seed..." class="input-field"/>
                <ui:Button text="Play" name="SeededPlayButton" class="animated-button"/>
                <ui:Button text="Back" name="SeededBackButton" class="animated-button" style="margin-top: 20px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="carSelectionView" class="view-container hidden">
            <ui:VisualElement name="WhiteBoard" class="panel" style="width: 800px;">
                <ui:Label text="Choose Your Car" class="title-label"/>
                <ui:VisualElement style="flex-direction: row; justify-content: space-around; width: 100%; margin-top: 20px;">
                    <ui:VisualElement class="car-option" style="align-items: center;">
                        <ui:Button name="BtnMonsterTruck" class="animated-button" style="width: 150px; height: 150px; border-radius: 20px; background-image: url(&quot;project://database/Assets/UI/Images/Monster_car.jpg?fileID=2800000&amp;guid=5f8bc2112d084c44ba96375f7dfce384&amp;type=3#Monster_car&quot;);"/>
                        <ui:Label text="Monster Truck" style="font-size: 20px; -unity-font-style: bold; margin-top: 10px; color: rgb(51, 51, 51);"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="car-option" style="align-items: center;">
                        <ui:Button name="BtnF1" class="animated-button" style="width: 150px; height: 150px; border-radius: 20px; background-image: url(&quot;project://database/Assets/UI/Images/F1_car.jpg?fileID=2800000&amp;guid=9adf7138dbf104546ba831d85f9be837&amp;type=3#F1_car&quot;);"/>
                        <ui:Label text="F1 Car" style="font-size: 20px; -unity-font-style: bold; margin-top: 10px; color: rgb(51, 51, 51);"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="car-option" style="align-items: center;">
                        <ui:Button name="BtnMuscle" class="animated-button" style="width: 150px; height: 150px; border-radius: 20px; background-image: url(&quot;project://database/Assets/UI/Images/Muscle_car.jpg?fileID=2800000&amp;guid=18b829f787f675f4ebbffe7573960660&amp;type=3#Muscle_car&quot;);"/>
                        <ui:Label text="Muscle Car" style="font-size: 20px; -unity-font-style: bold; margin-top: 10px; color: rgb(51, 51, 51);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button text="Back" name="CarSelectionBackButton" class="animated-button" style="margin-top: 40px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="obstacleChoiceView" class="view-container hidden">
            <ui:VisualElement name="WhiteBoard" class="panel">
                <ui:Label text="Obstacle Amount" class="title-label"/>
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                    <ui:Button text="Zero" name="Zero" class="animated-button" style="margin-bottom: 0; width: 160px;"/>
                    <ui:Label text="(Time limit -2s)" style="color: rgb(0, 0, 0); font-size: 22px; -unity-font-style: bold; margin-left: 15px; width: 180px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                    <ui:Button text="One" name="One" class="animated-button" style="margin-bottom: 0; width: 160px;"/>
                    <ui:Label text="(Normal time)" style="color: rgb(0, 0, 0); font-size: 22px; -unity-font-style: bold; margin-left: 15px; width: 180px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                    <ui:Button text="Two" name="Two" class="animated-button" style="margin-bottom: 0; width: 160px;"/>
                    <ui:Label text="(Time limit +2s)" style="color: rgb(0, 0, 0); font-size: 22px; -unity-font-style: bold; margin-left: 15px; width: 180px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="width:100%; flex-direction: row; align-items: center; justify-content:center; margin-top:8px; margin-bottom:8px; gap:10px;">
                    <ui:Label text="Number of Obstacles" class="obstacle-count-title" style="font-size: 20px; -unity-font-style: bold; color: rgb(51,51,51);"/>
                    <ui:Label text="0/0" name="ObstacleCountLabel" class="obstacle-count-label" style="font-size: 24px; -unity-font-style: bold; color: rgb(51,51,51);"/>
                </ui:VisualElement>
                <ui:Button text="Back" name="ObstaclesBackButton" class="animated-button" style="margin-top: 20px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="gameView" class="view-container hidden" style="background-color: transparent; pointer-events: none;">
            <ui:VisualElement class="top-bar" style="pointer-events: auto;">
                <ui:Button text="Pause" name="Pause" class="animated-button" style="width: 120px; height: 50px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="WhiteBox" class="hud-box" style="pointer-events: auto;">
                <ui:Label text="00:00" name="Timer" class="hud-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="LapHistoryBox" class="hud-box lap-history hidden" style="pointer-events: auto; top: 160px;">
                <ui:Label text="Last Laps" class="history-title"/>
                <ui:VisualElement name="LapList"/>
            </ui:VisualElement>
            <ui:VisualElement class="tacho-wrapper" style="pointer-events: none;">
                <ui:VisualElement name="TachometerContainer" class="tachometer-container">
                    <ui:VisualElement name="TachometerDial" class="tachometer-dial"/>
                    <ui:VisualElement name="TachometerNeedle" class="tachometer-needle"/>
                    <ui:VisualElement class="tachometer-pivot"/>
                    <ui:Label text="0 km/h" name="SpeedLabel" class="tachometer-text"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="CountdownBox" class="countdown-container hidden" style="pointer-events: none;">
                <ui:Label text="3" name="CountdownText" class="countdown-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pauseView" class="view-container hidden">
            <ui:VisualElement class="panel">
                <ui:Label text="Paused" class="title-label"/>
                <ui:Button text="Resume" name="ResumeButton" class="animated-button"/>
                <ui:Button text="Settings" name="PauseSettingsButton" class="animated-button"/>
                <ui:Button text="Main Menu" name="BackToMainButton" class="animated-button"/>
            </ui:VisualElement>
            <ui:VisualElement class="hud-box" style="position: absolute; top: 20px; right: 20px; align-items: center;">
                <ui:Label text="Current Map Seed:" style="font-size: 18px; color: rgb(139, 69, 19); -unity-font-style: bold; margin-bottom: 5px;"/>
                <ui:Label text="Unknown" name="MapSeedLabel" style="font-size: 24px; color: rgb(51, 51, 51); -unity-font-style: bold;"/>
                <ui:Button text="Copy Seed" name="CopySeedButton" class="animated-button" style="width: 120px; height: 30px; font-size: 14px; margin-top: 5px; padding: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settingsView" class="view-container hidden">
            <ui:VisualElement class="panel">
                <ui:Label text="Settings" class="title-label"/>
                <ui:Button text="Audio" name="SettingsAudioButton" class="animated-button"/>
                <ui:Toggle label="Fullscreen" name="FullscreenToggle" class="input-field"/>
                <ui:Button text="Back" name="SettingsBackButton" class="animated-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="audioSettingsView" class="view-container hidden">
            <ui:VisualElement class="panel" style="width: 600px;">
                <ui:Label text="Audio Settings" class="title-label"/>
                <ui:VisualElement style="margin-bottom: 12px;">
                    <ui:Label text="Master Volume" style="-unity-font-style: bold; color: rgb(51, 51, 51); font-size: 18px; margin-bottom: 5px;"/>
                    <ui:Slider name="MasterVolumeSlider" class="input-field" low-value="0" high-value="1" value="0.8"/>
                </ui:VisualElement>
                <ui:VisualElement style="margin-bottom: 12px;">
                    <ui:Label text="Music Volume" style="-unity-font-style: bold; color: rgb(51, 51, 51); font-size: 18px; margin-bottom: 5px;"/>
                    <ui:Slider name="MusicVolumeSlider" class="input-field" low-value="0" high-value="1" value="0.8"/>
                </ui:VisualElement>
                <ui:VisualElement style="margin-bottom: 12px;">
                    <ui:Label text="SFX Volume" style="-unity-font-style: bold; color: rgb(51, 51, 51); font-size: 18px; margin-bottom: 5px;"/>
                    <ui:Slider name="SfxVolumeSlider" class="input-field" low-value="0" high-value="1" value="0.8"/>
                </ui:VisualElement>
                <ui:VisualElement style="margin-bottom: 12px;">
                    <ui:Label text="UI Volume" style="-unity-font-style: bold; color: rgb(51, 51, 51); font-size: 18px; margin-bottom: 5px;"/>
                    <ui:Slider name="UiVolumeSlider" class="input-field" low-value="0" high-value="1" value="0.8"/>
                </ui:VisualElement>
                <ui:VisualElement style="margin-bottom: 12px;">
                    <ui:Label text="Car Volume" style="-unity-font-style: bold; color: rgb(51, 51, 51); font-size: 18px; margin-bottom: 5px;"/>
                    <ui:Slider name="CarVolumeSlider" class="input-field" low-value="0" high-value="1" value="0.8"/>
                </ui:VisualElement>
                <ui:Button text="Back" name="AudioSettingsBackButton" class="animated-button" style="margin-top: 20px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="aboutUsView" class="view-container hidden">
            <ui:VisualElement class="panel">
                <ui:Label text="About Us" class="title-label"/>
                <ui:Label text="Marek &quot;The Driver&quot; Jirusek" class="about-text"/>
                <ui:Label text="Car physics, Obstacle physics, Car sounds" class="about-text" style="font-size: 18px; margin-top: 0; -unity-font-style: normal;"/>
                <ui:Label text="Vitalij &quot;The Trapper&quot; Atamanjuk" class="about-text"/>
                <ui:Label text="Obstacle visuals, Audio, Effects" class="about-text" style="font-size: 18px; margin-top: 0; -unity-font-style: normal;"/>
                <ui:Label text="Tomas &quot;The Mapper&quot; Rybak" class="about-text"/>
                <ui:Label text="Map Generation, Game logic" class="about-text" style="font-size: 18px; margin-top: 0; -unity-font-style: normal;"/>
                <ui:Label text="Krystof &quot;The Artist&quot; Zak" class="about-text"/>
                <ui:Label text="Graphics designer, UI, Sounds" class="about-text" style="font-size: 18px; margin-top: 0; -unity-font-style: normal;"/>
                <ui:Button text="Back" name="AboutBackButton" class="animated-button" style="margin-top: 30px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="defeatView" class="view-container hidden">
            <ui:VisualElement class="panel">
                <ui:Label text="Out of Time!" class="title-label" style="color: rgb(255, 74, 74);"/>
                <ui:Label text="Best Lap: --:--" name="DefeatBestLap" class="stat-text"/>
                <ui:Label text="Obstacles Count: 0" name="DefeatObstacles" class="stat-text"/>
                <ui:Button text="Try Again" name="DefeatRetryButton" class="animated-button" style="margin-top: 30px;"/>
                <ui:Button text="Main Menu" name="DefeatMainMenuButton" class="animated-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="victoryView" class="view-container hidden">
            <ui:VisualElement class="panel">
                <ui:Label text="Victory!" class="title-label" style="color: rgb(50, 205, 50);"/>
                <ui:Label text="Best Lap: --:--" name="VictoryBestLap" class="stat-text"/>
                <ui:Label text="Obstacles Count: 0" name="VictoryObstacles" class="stat-text"/>
                <ui:Label text="Laps Completed: 3" name="VictoryLaps" class="stat-text"/>
                <ui:Button text="Play Again" name="VictoryRetryButton" class="animated-button" style="margin-top: 30px;"/>
                <ui:Button text="Main Menu" name="VictoryMainMenuButton" class="animated-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Discord Connect Popup View -->
        <ui:VisualElement name="discordConnectView" class="view-container hidden">
            <ui:VisualElement class="panel">
                <ui:Label text="Discord Connect" class="title-label"/>
                <ui:Label text="Enter this code in Discord to link your session:" style="font-size: 16px; color: rgb(51,51,51); margin-top: 10px; margin-bottom: 6px;"/>
                <ui:Label text="1111" name="DiscordCodeLabel" style="font-size: 48px; -unity-font-style: bold; color: rgb(88,101,242); margin-top: 6px; margin-bottom: 12px; align-self: center;"/>
                <ui:VisualElement style="flex-direction: row; justify-content: center; gap: 24px; margin-top: 12px;">
                    <ui:Button text="Copy Code" name="DiscordCopyButton" class="animated-button" style="width: 220px; padding-left: 8px; padding-right: 8px; font-size: 16px;"/>
                    <ui:Button text="Back" name="DiscordBackButton" class="animated-button" style="width: 140px; font-size: 16px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
